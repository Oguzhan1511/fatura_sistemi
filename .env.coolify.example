# İç ağ ayarı. :8000 Coolify paneli; :8765 fatura uygulamasıdır.
FATURA_PUBLIC_URL=http://10.21.41.219:8765
FATURA_ALLOW_PRIVATE_HTTP=true
FATURA_ADMIN_USER=yonetici
# En az 16 karakter. Gerçek parolayı sadece Coolify runtime secret alanına yazın.
FATURA_ADMIN_PASSWORD=
FATURA_DATA_DIR=/data
PORT=8765
# HTTPS alan adı kullanıldığında FATURA_ALLOW_PRIVATE_HTTP=false seçin.
